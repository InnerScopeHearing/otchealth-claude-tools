# credentials.env.template — reference only. DO NOT fill in real values here or
# commit a filled copy. The real ~/.designer/credentials.env is generated at
# session start by setup/session-start.sh from the fleet secret store.
#
# SECRET STORE (2026-08-18): the live store is AWS SSM Parameter Store, under
# /otchealth/<secret-id>, read by setup/fetch-secrets-aws.mjs. Azure Key Vault
# (kv-otc-55c84f6bef, setup/fetch-secrets-azure.mjs) is a demoted fallback and is
# expected to be dead while subscription 55c84f6b stays retired. GCP Secret
# Manager is fully retired (billing off, 2026-07).
#
# The secret-id -> env-var table is setup/secret-map.mjs. A single secret is
# materialized on demand with:  node setup/get-secret.mjs <secret-id> [outfile]

# ─── What to set in the environment (not here) ───────────────────────
# PRIMARY (AWS SSM). Inside AWS nothing is needed: the ECS/EC2 task role supplies
# credentials automatically. On a seat outside AWS, set:
AWS_ACCESS_KEY_ID=            # needs ssm:GetParameter + ssm:GetParametersByPath
AWS_SECRET_ACCESS_KEY=        #   on arn:aws:ssm:*:*:parameter/otchealth/*
AWS_REGION=us-east-1          # optional, this is the default
AWS_SSM_PREFIX=/otchealth     # optional, this is the default

# FALLBACK (Azure Key Vault). Optional; leave unset unless a vault is live again.
AZURE_SP_CLIENT_ID=
AZURE_SP_CLIENT_SECRET=
AZURE_SP_TENANT_ID=
AZURE_KEYVAULT_NAME=kv-otc-55c84f6bef

# ─── Fleet backend selection (static config, NOT secrets) ────────────
# session-start.sh exports these and writes them into the generated
# credentials.env. They exist because each corresponding script has an Azure-era
# default baked in; without them a script silently addresses a retired
# subscription. Override only to deliberately return to the Azure path.
SECRET_BACKEND=ssm            # ssm | keyvault      (azure-secret.mjs)
SEARCH_BACKEND=opensearch     # opensearch | azure  (kb-memory/index-one.mjs)
EMBEDDINGS_PROVIDER=openai    # openai | foundry    (kb-memory/index-one.mjs)
# SECRET_MIRROR_KEYVAULT=1    # re-arm the Key Vault leg of the rotation dual-write

# ─── Optional direct overrides ───────────────────────────────────────
# A value set directly in the environment WINS over the secret store (handy for
# local dev). Everything else is hydrated from the store via secret-map.mjs.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
RECRAFT_API_KEY=
